# =============================================================================
# Environment Configuration Template for dartfx-workspace-api
# Copy this file to .env on staging/production servers:
#   cp .env.example .env
# (.env is git-ignored so git pull will never overwrite server settings)
# =============================================================================

# Docker image tag to pull/run (e.g., latest, staging, 0.1.0)
IMAGE_TAG=latest

# Container name override
CONTAINER_NAME=dartfx-workspace-api

# Host interface & port binding
# Use 127.0.0.1 when running behind a local reverse proxy/gateway (Nginx, Kong, Caddy)
# Use 0.0.0.0 to expose the port on all network interfaces
HOST_BIND_IP=127.0.0.1
HOST_PORT=8000

# Reverse Proxy / API Gateway (Nginx & Kong) settings
# Note: Kong (with strip_path=true) and Nginx sending X-Forwarded-Prefix are detected
# automatically. You only need UVICORN_ROOT_PATH if your proxy strips the prefix without
# sending the X-Forwarded-Prefix header.
UVICORN_ROOT_PATH=
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=*

# CORS configuration
# Set to "*" (default), comma-separated origins ("https://app.example.com"),
# or "" (empty) to disable app-level CORS when Kong's CORS plugin handles it.
CORS_ORIGINS=*

# =============================================================================
# Application Persistence, Storage & 3-Tier Access Settings
# =============================================================================

# Database URL (SQLite for lightweight/testing, PostgreSQL for production)
# Examples:
#   sqlite:///./.dartfx-api/registry.db
#   postgresql+psycopg://dartfx:dartfx@postgres:5432/dartfx_workspace
DATABASE_URL=sqlite:///./.dartfx-api/registry.db

# Root directory for managed workspaces & public ephemeral sandbox
DARTFX_STORAGE_ROOT=./.dartfx-api/storage

# Default quota in MB for the Public Anonymous Ephemeral Sandbox workspace
DARTFX_PUBLIC_QUOTA_MB=50

# Optional static API keys (in addition to DB-managed keys created by Admin)
# Leave blank in local dev or set secure tokens in production
DARTFX_USER_API_KEY=
DARTFX_ADMIN_API_KEY=

# Optional Gemini API key for qsv describegpt fairify jobs
GEMINI_API_KEY=
